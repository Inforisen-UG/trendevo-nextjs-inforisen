# Local dev — production live site uses https://trendevo.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production example: NEXT_PUBLIC_SITE_URL=https://trendevo.com
NEXT_PUBLIC_API_URL=https://api.trendevo.com/api
NEXT_PUBLIC_PERFECT_APP_URL=https://my.trendevo.com
# Shown on /api (defaults to https://trendevo.com/api/v2 when unset locally)
# NEXT_PUBLIC_API_V2_URL=https://trendevo.com/api/v2
# Server-only — SMM panel API key (POST .../api/v2 action=services)
TRENDEVO_SMM_API_KEY=
# Optional override for panel base URL (defaults to NEXT_PUBLIC_PERFECT_APP_URL)
# TRENDEVO_SMM_API_URL=https://my.trendevo.com
